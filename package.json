{
  "name": "krizaka-blog",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "blog.krizaka.com — the Krizaka company blog: a static site built from MDX posts, edited by GitHub accounts.",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "gen": "node scripts/gen-favicon.mjs",
    "dev": "npm run gen && next dev",
    "build": "npm run gen && node scripts/build.mjs",
    "lint": "tsc --noEmit && krizaka-server-client-boundary && krizaka-i18n check messages && krizaka-code-names messages && node scripts/check-content.mjs && node scripts/gen-downloads.mjs check && npm run format:check",
    "test": "node --test tests/*.test.mjs",
    "links": "node scripts/check-links.mjs --base http://localhost:3000 --external",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "functions:bundle": "node scripts/bundle-functions.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\""
  },
  "dependencies": {
    "@krizaka/charts": "^1.0.0",
    "@krizaka/fonts": "^0.5.4",
    "@krizaka/i18n": "^0.2.7",
    "@krizaka/icons": "^0.10.0",
    "@krizaka/org": "^0.7.0",
    "@krizaka/query": "^0.3.0",
    "@krizaka/tailwind": "^4.5.0",
    "@krizaka/tokens": "^4.5.0",
    "@krizaka/ui": "^4.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@krizaka/config": "^0.10.0",
    "@krizaka/email": "^1.2.0",
    "@krizaka/rate-limit": "0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "htmlparser2": "^12.0.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0"
  },
  "overrides": {
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind",
    "minimatch@>=7.0.0 <11.0.1": "11.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
