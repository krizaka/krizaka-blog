# Build-time (set in .do/app.yaml, not secrets)
APP_INDEXING_ENABLED=false   # "true" opens the site to search engines (after the first post is published)
APP_SHOW_DRAFTS=             # "1" includes drafts in a local preview

# Run-time of the editor's sign-in function (DigitalOcean secrets; a GitHub OAuth App's id and secret)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
